{
  "AppSettings": {
    "Log": {
      "Diretorio": "logs",
      "ArquivosRetidos": 30
    },
    "Correios": {
      "UrlPortal": "https://rastreamento.correios.com.br/app/index.php",
      "TimeoutElementoSegundos": 20,
      "TimeoutPaginaSegundos": 40
    },
    "Navegador": {
      "Headless": true,
      "LarguraJanela": 1366,
      "AlturaJanela": 900
    },
    "Captcha": {
      "MaxTentativas": 15,
      "IntervaloEntreTentativasMs": 1500,
      "ConfiancaMinima": 0.0,
      "DiretorioTessdata": "tessdata",
      "DiretorioDebug": null
    },
    "Retry": {
      "MaxTentativasConsulta": 3,
      "EsperaInicialMs": 5000,
      "FatorBackoff": 2.0
    },
    "Lote": {
      "MaxParalelismo": 1,
      "IntervaloEntreConsultasMs": 1500
    },
    "Saida": {
      "DiretorioJson": "saida"
    }
  }
}
