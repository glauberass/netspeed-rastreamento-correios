<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host de linha de comando. Conhece o contêiner e a configuração; não conhece nenhum pipe.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NetSpeed.Executor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetSpeed.DependencyInjection\NetSpeed.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetSpeed.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
